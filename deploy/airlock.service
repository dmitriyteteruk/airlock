[Unit]
Description=Airlock bubble counter (fermentation monitor)
Documentation=file:__WORKDIR__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__WORKDIR__
ExecStart=__PYTHON__ -m airlock run --config __WORKDIR__/config.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=airlock

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# V4L2 — приоритетный бэкенд для USB-камер на Linux
Environment=OPENCV_VIDEOIO_PRIORITY_V4L2=1000
# OpenCV не должен порождать пул потоков на 4 ядрах Pi 3
Environment=OPENCV_FOR_THREADS_NUM=1

MemoryMax=400M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__WORKDIR__/data

[Install]
WantedBy=multi-user.target
